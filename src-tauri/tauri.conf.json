{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TAMI Configurator",
  "version": "1.0.0",
  "identifier": "ch.lighthousetech.tami.configurator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeBuildCommand": "node sync-frontend.js",
    "beforeDevCommand": "node sync-frontend.js"
  },
  "app": {
    "windows": [
      {
        "title": "TAMI Configurator – LightHouse Tech",
        "width": 1100,
        "height": 850,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "LightHouse Tech SA",
    "category": "Business",
    "shortDescription": "TAMI eyewear configurator",
    "longDescription": "Configure your TAMI assistive mobility eyewear: size, frame colour, and lens type.",
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
